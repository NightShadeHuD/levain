# Line endings, pinned so every platform checks out the same bytes.
* text=auto
*.json      text
*.md        text
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
gate.config text eol=lf
gate.config.pristine text eol=lf
pre-push    text eol=lf
mechanisms/hooks/* text eol=lf
tests/hooks/*      text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.svg       text
*.pdf       binary
*.zip       binary
